{
  "expo": {
    "name": "Papra",
    "slug": "papra-android-client",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "papra",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1512",
    "android": {
      "package": "sh.jtylab.papra",
      "adaptiveIcon": {
        "backgroundColor": "#10b981",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      "expo-local-authentication",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1512",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "*/*"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#10b981"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Scan",
              "label": "Scan to Papra",
              "description": "Open the document scanner",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1
            },
            {
              "name": "RecentDocuments",
              "label": "Recent documents",
              "description": "Latest documents from your Papra archive",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Papra uses the camera to scan documents."
        }
      ],
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "dataSync"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "sh.jtylab.papra"
    }
  }
}
